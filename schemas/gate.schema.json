{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-dev/gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "argv", "cwd", "timeoutSeconds", "required", "replaySafety", "effectClass", "network", "environmentAllowlist", "declaredWritePaths"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cwd": { "$ref": "#/$defs/repositoryPath" },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "required": { "type": "boolean" },
    "replaySafety": { "enum": ["pure", "idempotent", "manual-reconcile"] },
    "effectClass": { "enum": ["local-verification", "network-read", "external-write", "destructive", "release"] },
    "network": { "enum": ["deny", "approval-required"] },
    "environmentAllowlist": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "declaredWritePaths": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" }, "uniqueItems": true }
  },
  "$defs": { "repositoryPath": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" } }
}
