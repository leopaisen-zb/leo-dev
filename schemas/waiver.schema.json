{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-dev/waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "provenance", "actorLabel", "scope", "risk", "waivedRequirements", "timestamp", "expiresAt"],
  "properties": {
    "receiptId": { "type": "string", "minLength": 1 },
    "provenance": { "enum": ["platform-attested", "human-confirmed"] },
    "actorLabel": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["change", "task"] },
    "changeId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["lite", "standard", "full"] },
    "waivedRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "operationKind": { "not": { "enum": ["external-write", "destructive", "release", "deployment", "paid-service", "permission-expansion"] } }
  },
  "allOf": [
    { "if": { "properties": { "scope": { "const": "change" } }, "required": ["scope"] }, "then": { "properties": { "changeId": {} }, "required": ["changeId"], "not": { "properties": { "taskId": {} }, "required": ["taskId"] } } },
    { "if": { "properties": { "scope": { "const": "task" } }, "required": ["scope"] }, "then": { "properties": { "changeId": {}, "taskId": {} }, "required": ["changeId", "taskId"] } }
  ]
}
