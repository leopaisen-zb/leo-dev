{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-dev/archive-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeId", "releaseProofHash", "artifacts", "retrospective"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": { "type": "string", "minLength": 1 },
    "releaseProofHash": { "$ref": "#/$defs/hash" },
    "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
    "retrospective": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/hash" } } }
  }
}
