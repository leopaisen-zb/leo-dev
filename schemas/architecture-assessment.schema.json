{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-dev/architecture-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "changeId", "taskId", "specHash", "subjectTreeHash", "coverage", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assessmentId": { "$ref": "#/$defs/id" },
    "changeId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "specHash": { "$ref": "#/$defs/hash" },
    "subjectTreeHash": { "$ref": "#/$defs/hash" },
    "coverage": { "enum": ["complete", "partial"] },
    "findings": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/finding" } },
    "previousAssessmentFingerprint": { "$ref": "#/$defs/hash" },
    "resolutions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/resolution" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 512 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "relation", "boundary", "rationale", "evidence", "repairScope"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "severity": { "enum": ["low", "medium", "high"] },
        "relation": { "enum": ["worsened-by-change", "required-by-change", "unrelated"] },
        "boundary": { "type": "string", "minLength": 1, "maxLength": 2048 }, "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/evidence" } },
        "repairScope": { "enum": ["local", "material", "unknown"] }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["findingId", "rationale", "evidence"],
      "properties": { "findingId": { "$ref": "#/$defs/id" }, "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 }, "evidence": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/evidence" } } }
    }
  }
}
