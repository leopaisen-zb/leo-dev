{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-dev/reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "runId", "taskId", "taskRevision", "leaseGeneration", "operationFingerprint", "inputTreeHash", "evidenceHashes", "resolvedRunState", "sideEffectDisposition", "safeToRetry", "provenance", "actorLabel", "timestamp", "expiresAt"],
  "properties": {
    "receiptId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "taskRevision": { "type": "integer", "minimum": 1 },
    "leaseGeneration": { "type": "integer", "minimum": 1 },
    "operationFingerprint": { "$ref": "#/$defs/hash" },
    "inputTreeHash": { "$ref": "#/$defs/hash" },
    "evidenceHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" }, "uniqueItems": true },
    "resolvedRunState": { "enum": ["succeeded", "failed", "abandoned"] },
    "sideEffectDisposition": { "enum": ["completed", "failed", "not-started", "side-effects-absent", "side-effects-unknown"] },
    "safeToRetry": { "type": "boolean" },
    "provenance": { "enum": ["platform-attested", "human-confirmed"] },
    "actorLabel": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
